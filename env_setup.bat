npm init playwright@latest  //install the playwright.
npm install dotenv // load setting from your .env file into your code.
npm install @faker-js/faker  //generate realistic fake test data such as name,email,address.
npm install luxon  //handels dates and times.
npm install ajv csv-parse xlsx. // validate json data and read CSV/Excel test-data files.
npm install @axe-core/playwright.  // adds accessibility checks to you tests.
npm install allure-playwright. // produce the allure report used later in this guide. 
npm install -D @types/node.  // give typescript awareness of NOdes.js build-in feature.
npx playwright install // download actual browsers playwright will control.
npm install mysql2 --cache /tmp/empty-cache --force. // lets your tests connect to a MYSQL database.



